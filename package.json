{
  "name": "@my-mcp-hub/node-mcp-client",
  "version": "0.0.0",
  "description": "MCP Client Template For Node.js",
  "author": "zhensherlock",
  "type": "module",
  "license": "MIT",
  "files": [
    "build",
    "LICENSE",
    "README.md"
  ],
  "main": "build/index.js",
  "scripts": {
    "prepare": "husky",
    "lint": "npx eslint \"src/**/*.{ts,js}\"",
    "build": "tsc --noEmit && cross-env NODE_ENV=production node scripts/build.js",
    "dev": "cross-env NODE_ENV=local concurrently \"tsc --noEmit --watch\" \"node scripts/dev.js\"",
    "test": "vitest run",
    "coverage": "rimraf coverage && vitest run --coverage",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0 -n changelog-option.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "compare-func": "^2.0.0",
    "concurrently": "^10.0.4",
    "conventional-changelog-angular": "^9.0.0",
    "conventional-changelog-cli": "^5.0.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/my-mcp-hub/node-mcp-client.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
